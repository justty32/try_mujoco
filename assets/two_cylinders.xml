<mujoco model="two_cylinders_yaw">
  <statistic center="0 0 0.5"/>
  
  <worldbody>
    <!-- 地板與光源 -->
    <geom name="floor" size="1 1 .05" type="plane" rgba="0.8 0.8 0.8 1"/>
    <light pos="0 0 3"/>

    <!-- 1. 底座圓柱體 (Base Cylinder) -->
    <!-- 假設尺寸：半徑 0.1m, 半高 0.2m (總高 0.4m) -->
    <!-- 設定 pos="0 0 0.2" 讓底座正好貼在地板上 -->
    <body name="base_cylinder" pos="0 0 0.2">
      <geom name="base_geom" type="cylinder" size="0.1 0.2" rgba="0.2 0.6 0.8 1"/>

      <!-- 2. 頂部圓柱體 (Top Cylinder) -->
      <!-- 放在底座頂端，相對位置 Z = 0.2 (底座半高) + 0.1 (頂部半高) = 0.3 -->
      <body name="top_cylinder" pos="0 0 0.3">
        
        <!-- 【關鍵】只能 Yaw 旋轉的關節 -->
        <!-- axis="0 0 1" 代表繞 Z 軸旋轉，range 限制旋轉角度 -90 到 90 度 -->
        <joint name="yaw_joint" type="hinge" axis="0 0 1" range="-90 90" limited="true"/>

        <!-- 頂部圓柱體幾何特徵： -->
        <!-- 圓周 2 倍 -> 半徑變為 2 倍 (0.1 * 2 = 0.2m) -->
        <!-- 高度 1/2  -> 半高變為 0.5 倍 (0.2 * 0.5 = 0.1m) -->
        <geom name="top_geom" type="cylinder" size="0.2 0.1" rgba="0.9 0.4 0.3 1"/>
        
      </body>
    </body>
  </worldbody>

  <!-- 3. 馬達驅動器 (選配，讓你可以控制這個 Yaw 關節) -->
  <actuator>
    <motor name="yaw_motor" joint="yaw_joint" gear="10"/>
  </actuator>
</mujoco>
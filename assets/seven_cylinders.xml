<mujoco model="seven_cylinders_arm">
  <compiler angle="degree"/>
  <option timestep="0.002"/>
  <statistic center="0.25 0 0.35" extent="0.8"/>

  <default>
    <joint damping="1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <worldbody>
    <geom name="floor" size="2 2 .05" type="plane" rgba="0.8 0.8 0.8 1"/>
    <light pos="0 0 4"/>

    <!--
      七段 = 固定底座 + 3 組 (yaw 旋轉盤 + pitch 水平臂)，共 6 DoF。
      cylinder 的 size="radius half-length"；每支臂的 body 原點在關節，
      geom 中心移到臂長一半，下一個 body 則放在完整臂長的位置。
    -->

    <!-- Seg 1: 固定底座，半徑 0.10、總高 0.20。 -->
    <body name="base_cylinder" pos="0 0 0.10">
      <geom name="base_geom" type="cylinder" size="0.10 0.10" rgba="0.2 0.6 0.8 1"/>

      <!-- Seg 2: yaw1 旋轉盤，body 原點在底座頂面。 -->
      <body name="disc1" pos="0 0 0.10">
        <joint name="yaw1" type="hinge" axis="0 0 1" range="-90 90" limited="true"/>
        <geom name="disc1_geom" type="cylinder" pos="0 0 0.05"
              size="0.12 0.05" rgba="0.9 0.4 0.3 1"/>

        <!-- Seg 3: pitch1 水平臂，沿 +X 延伸 0.20，繞 Y 軸抬升。 -->
        <body name="arm1" pos="0 0 0.10">
          <joint name="pitch1" type="hinge" axis="0 1 0" range="-60 60" limited="true"/>
          <geom name="arm1_geom" type="cylinder" pos="0.10 0 0"
                size="0.05 0.10" euler="0 90 0" rgba="0.3 0.8 0.4 1"/>

          <!-- Seg 4: yaw2 旋轉盤，接在 arm1 末端。 -->
          <body name="disc2" pos="0.20 0 0">
            <joint name="yaw2" type="hinge" axis="0 0 1" range="-90 90" limited="true"/>
            <geom name="disc2_geom" type="cylinder" pos="0 0 0.045"
                  size="0.10 0.045" rgba="0.9 0.55 0.25 1"/>

            <!-- Seg 5: pitch2 水平臂，沿 +X 延伸 0.18。 -->
            <body name="arm2" pos="0 0 0.09">
              <joint name="pitch2" type="hinge" axis="0 1 0" range="-60 60" limited="true"/>
              <geom name="arm2_geom" type="cylinder" pos="0.09 0 0"
                    size="0.045 0.09" euler="0 90 0" rgba="0.4 0.85 0.35 1"/>

              <!-- Seg 6: yaw3 旋轉盤，接在 arm2 末端。 -->
              <body name="disc3" pos="0.18 0 0">
                <joint name="yaw3" type="hinge" axis="0 0 1" range="-90 90" limited="true"/>
                <geom name="disc3_geom" type="cylinder" pos="0 0 0.04"
                      size="0.08 0.04" rgba="0.9 0.7 0.2 1"/>

                <!-- Seg 7: pitch3 水平臂，沿 +X 延伸 0.16。 -->
                <body name="arm3" pos="0 0 0.08">
                  <joint name="pitch3" type="hinge" axis="0 1 0" range="-60 60" limited="true"/>
                  <geom name="arm3_geom" type="cylinder" pos="0.08 0 0"
                        size="0.04 0.08" euler="0 90 0" rgba="0.3 0.8 0.45 1"/>
                  <site name="end_effector" pos="0.16 0 0" size="0.015" rgba="1 0.1 0.1 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="yaw1_motor" joint="yaw1" gear="10"/>
    <motor name="pitch1_motor" joint="pitch1" gear="10"/>
    <motor name="yaw2_motor" joint="yaw2" gear="9"/>
    <motor name="pitch2_motor" joint="pitch2" gear="9"/>
    <motor name="yaw3_motor" joint="yaw3" gear="8"/>
    <motor name="pitch3_motor" joint="pitch3" gear="8"/>
  </actuator>
</mujoco>

